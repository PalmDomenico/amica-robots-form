# ==========================================================
#  Amica Robot Events - configurazione
#  Copia questo file in ".env" e compila i valori.
#  NON committare mai il file .env su GitHub.
# ==========================================================

# Immagine da usare con docker-compose (sostituisci <owner> con il tuo utente/organizzazione GitHub, in minuscolo)
IMAGE=ghcr.io/palmdomenico/amica-robots-form:latest

# Porta esposta sul server host
HOST_PORT=3000

# --- Endpoint Amica robot-events ---
ROBOT_API_URL=http://159.8.215.146:8000/robot-events/
ROBOT_API_KEY=inserisci-qui-la-api-key
ROBOT_API_TIMEOUT_MS=15000

# --- Utenti autorizzati ---
# Formato: utente:password separati da virgola.
# Le password possono essere in chiaro oppure hash bcrypt (consigliato).
# Per generare un hash:
#   docker run --rm ghcr.io/palmdomenico/amica-robots-form node scripts/hash-password.js "LaMiaPassword"
# ATTENZIONE: negli hash bcrypt raddoppia ogni "$" in "$$" (docker compose interpreta "$" come variabile),
# oppure usa AUTH_USERS_FILE.
AUTH_USERS=admin:CambiaQuestaPassword!

# In alternativa (o in aggiunta): file JSON montato nel container
#   [{ "username": "mario", "password": "$2b$12$..." }]
# AUTH_USERS_FILE=/app/config/users.json

# --- Sessione ---
# Stringa casuale lunga (es. output di: openssl rand -hex 32)
SESSION_SECRET=cambia-con-una-stringa-casuale-lunga
SESSION_MAX_AGE_HOURS=8

# Imposta a true se il sito e' servito in HTTPS (es. dietro reverse proxy con certificato)
COOKIE_SECURE=false
# Imposta a true se il container e' dietro un reverse proxy (nginx, traefik, caddy...)
TRUST_PROXY=false
